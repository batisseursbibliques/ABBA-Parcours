rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coordinateur "de secours" — reste actif même si la liste dynamique ci-dessous est vide.
    // C'est un filet de sécurité pour ne jamais être bloqué hors de l'app.
    function isBootstrapAdmin() {
      return request.auth != null &&
        request.auth.token.email.lower() in [
          'apotrepaulabba@gmail.com'
        ];
    }

    // Coordinateur "actif" = le filet de sécurité, OU présent dans la liste
    // gérée dynamiquement depuis l'app (collection /admins).
    function isAdmin() {
      return request.auth != null && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }

    // Droits d'un coordinateur, cochés par le coordinateur principal dans l'app (doc admins/{email}.droits).
    // Le principal a tous les droits. Sans réglage de droits, un coordinateur garde tout sauf l'aperçu.
    function adminDocData() { return get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data; }
    function hasDroit(d) {
      return request.auth != null && (
        isBootstrapAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
          (('droits' in adminDocData()) ? adminDocData().droits.get(d, false) == true : (d != 'apercu' && d != 'paiements')))
      );
    }


    // Deuxième signature des documents : si le document porte « sigCoord », ce numéro de version doit être
    // celui que le pays indiqué publie actuellement dans /signataires (le document ne peut pas citer une signature au hasard).
    function sigCoordOk() {
      return (!('pays' in request.resource.data) || (request.resource.data.pays is string && request.resource.data.pays.size() == 2))
        && (!('sigCoord' in request.resource.data)
            || ('pays' in request.resource.data
                && exists(/databases/$(database)/documents/signataires/$(request.resource.data.pays))
                && get(/databases/$(database)/documents/signataires/$(request.resource.data.pays)).data.get('sigId', '') == request.resource.data.sigCoord));
    }

    // Paiement : 5 000 F en cinq paliers. Un module n'accepte ni réponses ni fiche tant que le palier n'est pas payé.
    // Sans compte de paiement (cohorte d'avant), aucun blocage.
    function palier(mid) {
      return {'charte': 1, 'autoeval': 1, 'm1': 1, 'm2': 1, 'm3': 1, 'm4': 2, 'm5': 2, 'm6': 2, 'm7': 3, 'm8': 3, 'm9': 3,
              'm10': 4, 'm11': 4, 'm12': 4, 'm13': 5, 'm14': 5, 'm14b': 5}.get(mid, 1);
    }
    function payeOk(uid, mid) {
      return !exists(/databases/$(database)/documents/formation/$(uid)/compte/paiement)
        || get(/databases/$(database)/documents/formation/$(uid)/compte/paiement).data.get('actif', true) == false
        || get(/databases/$(database)/documents/formation/$(uid)/compte/paiement).data.get('paye', 0) * 5
           >= get(/databases/$(database)/documents/formation/$(uid)/compte/paiement).data.get('total', 5000) * palier(mid);
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if hasDroit('suivi') || hasDroit('corrections') || hasDroit('presences') || hasDroit('binomes') || hasDroit('paiements');

      match /priv/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        // Le coordinateur a besoin d'écrire ce repère précis quand il relie deux Bâtisseurs —
        // il ne touche à rien d'autre dans l'espace privé de la personne.
        allow write: if hasDroit('binomes') && doc == "binome";
        // Fiche de contact (adresse, naissance, urgence…) : lisible par le suivi et par le correcteur lié à l'élève
        allow read: if doc == "contact" && (hasDroit('suivi') || isCorrecteurOf(uid));
      }

      // Données mensuelles (spirituel + bilans + finance), un document par mois AAAA-MM
      match /months/{monthKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /summaries/{uid} {
      allow read: if hasDroit('suivi');
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /config/{doc} {
      allow read: if request.auth != null && doc != 'solidarite';
      allow write: if isAdmin() && doc != 'paiement' && doc != 'solidarite';
    }
    // Fonds de solidarité (solde) : réservé au coordinateur principal et à la trésorière
    match /config/solidarite {
      allow read, write: if hasDroit('paiements');
    }
    // Dons au fonds de solidarité : chacun voit les siens ; la trésorière confirme ; le bénéficiaire ne voit jamais le donateur
    match /solidarite/{sid} {
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || hasDroit('paiements');
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','nom','montant','mode','reference','statut','creeLe','updatedAt'])
        && request.resource.data.statut == 'attente'
        && request.resource.data.montant is number && request.resource.data.montant >= 100 && request.resource.data.montant <= 1000000
        && request.resource.data.mode in ['mobile-money','especes','autre'];
      allow update: if hasDroit('paiements')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','traitePar','traiteLe','recuNum','updatedAt']);
    }
    // Texte « Comment payer » : seuls le coordinateur principal et la trésorière (droit « paiements »)
    match /config/paiement {
      allow read: if request.auth != null;
      allow write: if hasDroit('paiements');
    }
    // Note : la liste des modules partagée vit aussi dans /config/{doc} (doc "modules"), déjà couverte ci-dessus.

    // Liste des coordinateurs, modifiable uniquement par un coordinateur déjà actif
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isBootstrapAdmin();
    }


    // Signatures des coordinateurs (versions figées). Lisibles par qui connaît le numéro (la page certificat.html n'a pas de connexion),
    // jamais listables, jamais modifiables. Création : le coordinateur principal pour n'importe qui,
    // ou un coordinateur national pour lui-même et pour son propre pays.
    match /signatures/{sid} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email','nom','fonction','pays','paysFr','paysEn','image','creeLe'])
        && request.resource.data.creeLe == request.time
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 100
        && request.resource.data.image is string && request.resource.data.image.size() < 400000
        && request.resource.data.image.matches('^data:image/png;base64,.*')
        && request.resource.data.fonction in ['national','local','special']
        && (isBootstrapAdmin()
            || (isAdmin()
                && request.resource.data.email == request.auth.token.email.lower()
                && request.resource.data.fonction == 'national'
                && adminDocData().get('fonction', '') == 'national'
                && adminDocData().get('pays', '') == request.resource.data.pays));
      allow update: if false;
      allow delete: if isBootstrapAdmin();
    }

    // Version de signature actuelle du coordinateur national de chaque pays (code à deux lettres)
    match /signataires/{pays} {
      allow get: if true;
      allow list: if false;
      allow write: if isBootstrapAdmin()
        || (isAdmin() && request.resource != null
            && adminDocData().get('fonction', '') == 'national'
            && adminDocData().get('pays', '') == pays
            && request.resource.data.keys().hasOnly(['sigId','email','nom','maj'])
            && request.resource.data.email == request.auth.token.email.lower());
    }

    // Binômes (accountability) : le coordinateur crée/supprime la paire,
    // les deux membres peuvent ensuite modifier librement leur fiche partagée.
    match /binomes/{pairId} {
      allow read: if hasDroit('binomes') || (request.auth != null && request.auth.token.email.lower() in [resource.data.membre1, resource.data.membre2]);
      allow create, delete: if hasDroit('binomes');
      allow update: if hasDroit('binomes') || (request.auth != null && request.auth.token.email.lower() in [resource.data.membre1, resource.data.membre2]);
    }

    // Séances et présence — chacun voit son propre suivi, seul le coordinateur marque la présence.
    match /seances/{seanceId} {
      allow read: if request.auth != null;
      allow write: if hasDroit('presences');
    }

    // Appareils inscrits aux rappels (notifications push) : seule la personne les gère ; le serveur d'envoi les lit avec la clé de service
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Demandes de suppression de compte : la personne la crée / l'annule, le suivi la lit et la traite
    match /deletionRequests/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.status == "pending";
      allow read, delete: if (request.auth != null && request.auth.uid == uid) || hasDroit('suivi');
      allow update: if hasDroit('suivi');
    }

    match /enrollments/{enrollId} {
      allow read: if hasDroit('presences') || hasDroit('paiements')
        || (request.auth != null && enrollId.matches(request.auth.uid + '_.*'));
      // Demande d'accès : seuls les champs prévus, de longueur raisonnable, au nom de la personne connectée
      allow create: if request.auth != null
        && enrollId.matches(request.auth.uid + '_.*')
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly(['uid','app','nom','prenom','email','telephone','naissance','mineur',
             'tuteurNom','tuteurTel','autorisationParentale','via','status','requestedAt','reviewedBy','reviewedAt'])
        && request.resource.data.keys().hasAll(['uid','app','status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.app is string && request.resource.data.app.size() <= 30
        && request.resource.data.get('reviewedBy', null) == null
        && request.resource.data.get('nom', '') is string && request.resource.data.get('nom', '').size() <= 150
        && request.resource.data.get('prenom', '') is string && request.resource.data.get('prenom', '').size() <= 150
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 200
        && request.resource.data.get('telephone', '') is string && request.resource.data.get('telephone', '').size() <= 40
        && request.resource.data.get('naissance', '') is string && request.resource.data.get('naissance', '').size() <= 20
        && request.resource.data.get('tuteurNom', '') is string && request.resource.data.get('tuteurNom', '').size() <= 150
        && request.resource.data.get('tuteurTel', '') is string && request.resource.data.get('tuteurTel', '').size() <= 40
        && request.resource.data.get('via', '') is string && request.resource.data.get('via', '').size() <= 60;
      allow update: if hasDroit('presences');
      allow delete: if hasDroit('presences');
    }

    // ===== FORMATION EN AUTONOMIE (correcteurs, liens, progression par module) =====
    function myEmail() { return request.auth.token.email.lower(); }

    // Le correcteur désigné pour cet étudiant (lien posé par le coordinateur)
    function isCorrecteurOf(uid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/liens/$(uid)) &&
        get(/databases/$(database)/documents/liens/$(uid)).data.correcteurEmail == myEmail();
    }

    // Vérification publique d'une attestation ou d'un certificat : on peut LIRE un document dont on connaît le numéro,
    // mais pas lister les documents. Création : l'étudiant pour son propre module validé, le coordinateur pour le certificat final.
    match /attestations/{numero} {
      allow get: if true;
      allow list: if hasDroit('suivi');   // la liste complète (noms) est réservée aux coordinateurs
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['numero','type','nom','titre','mid','date','creeLe','source','pays','sigCoord'])
        && sigCoordOk()
        && (!('source' in request.resource.data) || (request.resource.data.source == 'manuel' && request.resource.data.type == 'parcours'))
        && request.resource.data.numero == numero
        && request.resource.data.creeLe == request.time
        && request.resource.data.nom is string && request.resource.data.nom.size() >= 1 && request.resource.data.nom.size() <= 150
        && request.resource.data.titre is string && request.resource.data.titre.size() <= 200
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && ((request.resource.data.type == 'module'
              && request.resource.data.mid is string
              && request.resource.data.nom == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nom
              && ((get(/databases/$(database)/documents/formation/$(request.auth.uid)/modules/$(request.resource.data.mid)).data.ficheStatus == 'validated'
                   && get(/databases/$(database)/documents/formation/$(request.auth.uid)/modules/$(request.resource.data.mid)).data.get('qcm', {}).get('ok', false) == true)
                  || request.resource.data.mid in get(/databases/$(database)/documents/formation/$(request.auth.uid)).data.get('acquis', [])))
            || (request.resource.data.type == 'parcours' && hasDroit('suivi')));
      allow update: if false;
      allow delete: if hasDroit('suivi');
    }

    // Historique mensuel de la promotion : un « point » par mois (chiffres et statut de chaque compte, sans nom).
    // Seul le point du mois en cours peut être écrit ou mis à jour ; les mois passés ne bougent plus.
    match /rapports/{mois} {
      allow read: if hasDroit('suivi');
      allow create, update: if hasDroit('suivi')
        && mois == string(request.time.year()) + '-' + (request.time.month() < 10 ? '0' : '') + string(request.time.month())
        && request.resource.data.keys().hasOnly(['mois','g','parModule','correcteurs','sansCorrecteur','lignes','maj'])
        && request.resource.data.mois == mois
        && request.resource.data.maj == request.time;
      allow delete: if false;
    }

    // Journal des actions sensibles : on peut seulement AJOUTER une ligne (au nom de soi-même, à l'heure du serveur),
    // jamais la modifier ni l'effacer. Lecture : coordinateur principal.
    match /journal/{jid} {
      allow read: if isBootstrapAdmin();
      allow create: if request.auth != null
        && (isAdmin() || exists(/databases/$(database)/documents/correcteurs/$(myEmail())))
        && request.resource.data.keys().hasOnly(['action','cible','detail','par','parUid','date'])
        && request.resource.data.par == myEmail()
        && request.resource.data.parUid == request.auth.uid
        && request.resource.data.date == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 60
        && request.resource.data.cible is string && request.resource.data.cible.size() <= 160
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 300;
      allow update, delete: if false;
    }

    // Liste des correcteurs : gérée par le coordinateur
    match /correcteurs/{email} {
      allow read: if hasDroit('corrections') || hasDroit('suivi') || (request.auth != null && email == myEmail());
      allow write: if hasDroit('corrections');
    }

    // Lien étudiant -> correcteur : posé par le coordinateur
    match /liens/{uid} {
      allow read: if hasDroit('corrections') || hasDroit('suivi')
        || (request.auth != null && request.auth.uid == uid)
        || (request.auth != null && resource.data.correcteurEmail == myEmail());
      allow write: if hasDroit('corrections');
    }

    // Parcours bloqué par le coordinateur (champ formation/{uid}.bloque.actif) : l'élève ne peut plus écrire dans ses modules
    function isBlocked(uid) {
      return exists(/databases/$(database)/documents/formation/$(uid)) &&
        get(/databases/$(database)/documents/formation/$(uid)).data.get('bloque', {}).get('actif', false) == true;
    }

    match /formation/{uid} {
      // Document de synthèse (modules acquis, posés par le coordinateur)
      allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);
      allow write: if hasDroit('suivi');

      match /modules/{mid} {
        allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);

        // L'étudiant écrit ses réponses, jamais la validation
        allow create: if request.auth != null && request.auth.uid == uid && !isBlocked(uid) && payeOk(uid, mid)
          && request.resource.data.keys().hasOnly(['qcm','exercices','ficheData','ficheStatus','submittedAt','updatedAt','lu','done','doneAt'])
          && request.resource.data.get('ficheStatus', 'draft') in ['draft', 'submitted'];

        allow update: if (request.auth != null && request.auth.uid == uid && !isBlocked(uid) && payeOk(uid, mid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qcm','exercices','ficheData','ficheStatus','submittedAt','updatedAt','lu','done','doneAt'])
            && resource.data.get('ficheStatus', 'draft') in ['draft', 'returned']
            && (request.resource.data.get('ficheStatus', 'draft') in ['draft', 'submitted']
                || (request.resource.data.get('ficheStatus', 'draft') == 'returned' && resource.data.get('ficheStatus', 'draft') == 'returned')))
          // Le correcteur valide ou renvoie une fiche envoyée, rien d'autre
          || (isCorrecteurOf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ficheStatus','validatedBy','validatedAt','correctorComment'])
            && resource.data.get('ficheStatus', 'draft') == 'submitted'
            && request.resource.data.ficheStatus in ['validated', 'returned'])
          // Les coordinateurs gardent leurs autres écritures (réglages, reprise...), mais JAMAIS la correction :
          // valider ou renvoyer une fiche appartient au seul correcteur désigné pour l'étudiant (isCorrecteurOf).
          || ((hasDroit('corrections') || hasDroit('suivi'))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ficheStatus','validatedBy','validatedAt','correctorComment']));

        allow delete: if hasDroit('suivi');
      }

      // Avis de l'étudiant sur un module (facultatif) : deux notes de 1 à 5 et un mot libre.
      // L'étudiant l'écrit seulement pour un module qu'il a terminé ; les coordinateurs le lisent.
      match /avis/{mid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || hasDroit('suivi');
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['clarte','utilite','manque','maj'])
          && request.resource.data.clarte is int && request.resource.data.clarte >= 1 && request.resource.data.clarte <= 5
          && request.resource.data.utilite is int && request.resource.data.utilite >= 1 && request.resource.data.utilite <= 5
          && request.resource.data.manque is string && request.resource.data.manque.size() <= 500
          && request.resource.data.maj == request.time
          && ((get(/databases/$(database)/documents/formation/$(uid)/modules/$(mid)).data.get('ficheStatus', '') == 'validated')
              || mid in get(/databases/$(database)/documents/formation/$(uid)).data.get('acquis', []));
        allow delete: if false;
      }

      // Attestations et certificat : copie privée de l'étudiant (le document public de vérification est dans /attestations)
      match /attestations/{key} {
        allow read: if (request.auth != null && request.auth.uid == uid) || hasDroit('suivi');
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['numero','type','nom','titre','mid','date','creeLe','pays','sigCoord'])
          && sigCoordOk()
          && request.resource.data.creeLe == request.time
          && ((request.auth.uid == uid && request.resource.data.type == 'module' && request.resource.data.mid == key)
              || (request.resource.data.type == 'parcours' && key == 'parcours' && hasDroit('suivi')));
        allow update: if false;
        allow delete: if hasDroit('suivi');
      }

      // Échanges (messages) entre l'étudiant et son correcteur : on ajoute, on ne modifie pas
      match /echanges/{eid} {
        allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['mid','de','texte','parUid','date'])
          && request.resource.data.parUid == request.auth.uid
          && request.resource.data.date == request.time
          && request.resource.data.mid is string && request.resource.data.mid.size() <= 12
          && request.resource.data.texte is string && request.resource.data.texte.size() >= 1 && request.resource.data.texte.size() <= 1000
          && ((request.resource.data.de == 'eleve' && request.auth.uid == uid && !isBlocked(uid))
              || (request.resource.data.de == 'correcteur' && isCorrecteurOf(uid)));
        allow update: if false;
        allow delete: if hasDroit('suivi');
      }

      // Exercices qui s'étalent sur plusieurs jours (7 jours, 21 jours...) : le simple fait de les
      // commencer compte ; les cases quotidiennes restent cochables même après l'envoi de la fiche.
      match /suivis/{sid} {
        allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);
        allow create: if request.auth != null && request.auth.uid == uid && (sid == 'declaration' || sid == 'journee' || !isBlocked(uid))
          && request.resource.data.keys().hasOnly(['mid','exId','fid','titre','jours','labels','cibles','pas','start','done','notes','updatedAt']);
        allow update: if (request.auth != null && request.auth.uid == uid && (sid == 'declaration' || sid == 'journee' || !isBlocked(uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','notes','updatedAt']))
          || hasDroit('suivi');
        allow delete: if hasDroit('suivi');
      }

      // Révisions après validation : réponses refaites, privées (ni correcteur ni coordinateur ne les lisent)
      match /revisions/{mid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lu','qcm','exercices','updatedAt']);
      }

      // Paiement : compte (total, payé), versements et déclarations de l'étudiant
      match /compte/{cid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || hasDroit('paiements') || hasDroit('suivi');
        // À l'approbation d'une inscription, un compte standard (5 000 F, rien de payé) peut être créé par le suivi ;
        // tout le reste (versements, réductions, dispenses) est réservé au droit « paiements ».
        allow create: if cid == 'paiement' && (hasDroit('paiements')
          || ((hasDroit('suivi') || hasDroit('presences'))
              && request.resource.data.keys().hasOnly(['actif','total','paye','creeLe','updatedAt'])
              && request.resource.data.total == 5000 && request.resource.data.paye == 0 && request.resource.data.actif == true));
        allow update: if hasDroit('paiements');
      }
      match /paiements/{pid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || hasDroit('paiements') || hasDroit('suivi');
        allow create: if hasDroit('paiements')
          && request.resource.data.keys().hasOnly(['montant','mode','reference','date','note','recuNum','parEmail','creeLe','declId','updatedAt'])
          && request.resource.data.montant is number && request.resource.data.montant > 0 && request.resource.data.montant <= 100000;
        allow update: if hasDroit('paiements')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['annule','annulePar','annuleLe','note','updatedAt']);
      }
      match /declarations/{did} {
        allow read: if (request.auth != null && request.auth.uid == uid) || hasDroit('paiements');
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['montant','mode','reference','statut','creeLe','updatedAt'])
          && request.resource.data.statut == 'attente'
          && request.resource.data.montant is number && request.resource.data.montant >= 100 && request.resource.data.montant <= 100000
          && request.resource.data.mode in ['mobile-money','especes','autre'];
        allow update: if hasDroit('paiements')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','traitePar','traiteLe','updatedAt']);
      }

      // Calendrier de lecture : jours lus (écrits par l'élève) + résumé lisible par le suivi
      match /lecture/{pid} {
        allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['plan','start','done','resume','updatedAt']);
        allow delete: if hasDroit('suivi');
      }

      // Indisponibilités signalées par l'élève (maladie, déplacement…) : visibles par lui, son correcteur et les coordinateurs
      match /indispos/{iid} {
        allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['debut','fin','finInconnue','motif','creeLe','updatedAt'])
          && request.resource.data.motif is string
          && request.resource.data.motif.size() >= 10 && request.resource.data.motif.size() <= 2000;
        // L'élève met fin ou annule ; le correcteur ou le coordinateur marque seulement « pris en compte »
        allow update: if (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fin','finInconnue','repriseLe','annule','updatedAt']))
          || ((hasDroit('suivi') || hasDroit('corrections') || isCorrecteurOf(uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vu','updatedAt']));
        allow delete: if hasDroit('suivi');
      }
    }
  }
}
