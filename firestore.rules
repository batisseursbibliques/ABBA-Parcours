rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coordinateur "de secours" — reste actif même si la liste dynamique ci-dessous est vide.
    // C'est un filet de sécurité pour ne jamais être bloqué hors de l'app.
    function isBootstrapAdmin() {
      return request.auth != null &&
        request.auth.token.email.lower() in [
          'apotrepaulabba@gmail.com'
        ];
    }

    // Coordinateur "actif" = le filet de sécurité, OU présent dans la liste
    // gérée dynamiquement depuis l'app (collection /admins).
    function isAdmin() {
      return request.auth != null && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }

    // Droits d'un coordinateur, cochés par le coordinateur principal dans l'app (doc admins/{email}.droits).
    // Le principal a tous les droits. Sans réglage de droits, un coordinateur garde tout sauf l'aperçu.
    function adminDocData() { return get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data; }
    function hasDroit(d) {
      return request.auth != null && (
        isBootstrapAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
          (('droits' in adminDocData()) ? adminDocData().droits.get(d, false) == true : d != 'apercu'))
      );
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if hasDroit('suivi') || hasDroit('corrections') || hasDroit('presences') || hasDroit('binomes');

      match /priv/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        // Le coordinateur a besoin d'écrire ce repère précis quand il relie deux Bâtisseurs —
        // il ne touche à rien d'autre dans l'espace privé de la personne.
        allow write: if hasDroit('binomes') && doc == "binome";
      }

      // Données mensuelles (spirituel + bilans + finance), un document par mois AAAA-MM
      match /months/{monthKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /summaries/{uid} {
      allow read: if hasDroit('suivi');
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Note : la liste des modules partagée vit aussi dans /config/{doc} (doc "modules"), déjà couverte ci-dessus.

    // Liste des coordinateurs, modifiable uniquement par un coordinateur déjà actif
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isBootstrapAdmin();
    }

    // Binômes (accountability) : le coordinateur crée/supprime la paire,
    // les deux membres peuvent ensuite modifier librement leur fiche partagée.
    match /binomes/{pairId} {
      allow read: if hasDroit('binomes') || (request.auth != null && request.auth.token.email.lower() in [resource.data.membre1, resource.data.membre2]);
      allow create, delete: if hasDroit('binomes');
      allow update: if hasDroit('binomes') || (request.auth != null && request.auth.token.email.lower() in [resource.data.membre1, resource.data.membre2]);
    }

    // Séances et présence — chacun voit son propre suivi, seul le coordinateur marque la présence.
    match /seances/{seanceId} {
      allow read: if request.auth != null;
      allow write: if hasDroit('presences');
    }

    match /enrollments/{enrollId} {
      allow read: if hasDroit('presences')
        || (request.auth != null && enrollId.matches(request.auth.uid + '_.*'));
      allow create: if request.auth != null
        && enrollId.matches(request.auth.uid + '_.*')
        && request.resource.data.status == "pending";
      allow update: if hasDroit('presences');
      allow delete: if hasDroit('presences');
    }

    // ===== FORMATION EN AUTONOMIE (correcteurs, liens, progression par module) =====
    function myEmail() { return request.auth.token.email.lower(); }

    // Le correcteur désigné pour cet étudiant (lien posé par le coordinateur)
    function isCorrecteurOf(uid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/liens/$(uid)) &&
        get(/databases/$(database)/documents/liens/$(uid)).data.correcteurEmail == myEmail();
    }

    // Liste des correcteurs : gérée par le coordinateur
    match /correcteurs/{email} {
      allow read: if hasDroit('corrections') || hasDroit('suivi') || (request.auth != null && email == myEmail());
      allow write: if hasDroit('corrections');
    }

    // Lien étudiant -> correcteur : posé par le coordinateur
    match /liens/{uid} {
      allow read: if hasDroit('corrections') || hasDroit('suivi')
        || (request.auth != null && request.auth.uid == uid)
        || (request.auth != null && resource.data.correcteurEmail == myEmail());
      allow write: if hasDroit('corrections');
    }

    // Parcours bloqué par le coordinateur (champ formation/{uid}.bloque.actif) : l'élève ne peut plus écrire dans ses modules
    function isBlocked(uid) {
      return exists(/databases/$(database)/documents/formation/$(uid)) &&
        get(/databases/$(database)/documents/formation/$(uid)).data.get('bloque', {}).get('actif', false) == true;
    }

    match /formation/{uid} {
      // Document de synthèse (modules acquis, posés par le coordinateur)
      allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);
      allow write: if hasDroit('suivi');

      match /modules/{mid} {
        allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);

        // L'étudiant écrit ses réponses, jamais la validation
        allow create: if request.auth != null && request.auth.uid == uid && !isBlocked(uid)
          && request.resource.data.keys().hasOnly(['qcm','exercices','ficheData','ficheStatus','submittedAt','updatedAt','lu','done','doneAt'])
          && request.resource.data.get('ficheStatus', 'draft') in ['draft', 'submitted'];

        allow update: if (request.auth != null && request.auth.uid == uid && !isBlocked(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qcm','exercices','ficheData','ficheStatus','submittedAt','updatedAt','lu','done','doneAt'])
            && resource.data.get('ficheStatus', 'draft') in ['draft', 'returned']
            && (request.resource.data.get('ficheStatus', 'draft') in ['draft', 'submitted']
                || (request.resource.data.get('ficheStatus', 'draft') == 'returned' && resource.data.get('ficheStatus', 'draft') == 'returned')))
          // Le correcteur valide ou renvoie une fiche envoyée, rien d'autre
          || (isCorrecteurOf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ficheStatus','validatedBy','validatedAt','correctorComment'])
            && resource.data.get('ficheStatus', 'draft') == 'submitted'
            && request.resource.data.ficheStatus in ['validated', 'returned'])
          || hasDroit('corrections') || hasDroit('suivi');

        allow delete: if hasDroit('suivi');
      }

      // Exercices qui s'étalent sur plusieurs jours (7 jours, 21 jours...) : le simple fait de les
      // commencer compte ; les cases quotidiennes restent cochables même après l'envoi de la fiche.
      match /suivis/{sid} {
        allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);
        allow create: if request.auth != null && request.auth.uid == uid && (sid == 'declaration' || sid == 'journee' || !isBlocked(uid))
          && request.resource.data.keys().hasOnly(['mid','exId','fid','titre','jours','labels','cibles','pas','start','done','notes','updatedAt']);
        allow update: if (request.auth != null && request.auth.uid == uid && (sid == 'declaration' || sid == 'journee' || !isBlocked(uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','notes','updatedAt']))
          || hasDroit('suivi');
        allow delete: if hasDroit('suivi');
      }

      // Révisions après validation : réponses refaites, privées (ni correcteur ni coordinateur ne les lisent)
      match /revisions/{mid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lu','qcm','exercices','updatedAt']);
      }

      // Indisponibilités signalées par l'élève (maladie, déplacement…) : visibles par lui, son correcteur et les coordinateurs
      match /indispos/{iid} {
        allow read: if hasDroit('suivi') || hasDroit('corrections') || (request.auth != null && request.auth.uid == uid) || isCorrecteurOf(uid);
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['debut','fin','finInconnue','motif','creeLe','updatedAt'])
          && request.resource.data.motif is string
          && request.resource.data.motif.size() >= 10 && request.resource.data.motif.size() <= 2000;
        // L'élève met fin ou annule ; le correcteur ou le coordinateur marque seulement « pris en compte »
        allow update: if (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fin','finInconnue','repriseLe','annule','updatedAt']))
          || ((hasDroit('suivi') || hasDroit('corrections') || isCorrecteurOf(uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vu','updatedAt']));
        allow delete: if hasDroit('suivi');
      }
    }
  }
}
